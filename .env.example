# Optional: `docker compose up` already has every default. To override, cp .env.example .env
# (.env is gitignored; this file only holds fake values).

# local/test log DEBUG; production logs INFO and up.
APP_ENV=local

SERVICE_NAME=bootcamp-api

# For tools running on the host; inside compose the host is always "db".
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@localhost:5432/bootcamp

# Callers send the header INTERNAL-TOKEN: <value>.
INTERNAL_TOKEN=default_token

# Where the tests look for the API when run outside Docker.
SERVER_LOCALHOST=0.0.0.0

# Inherited bank slip connector, unused here (ADR 0002). Inside the container localhost is the container itself.
BANKSLIP_API_URL=http://localhost:8080

BANKSLIP_API_INTERNAL_TOKEN=default_token

BANKSLIP_API_TIMEOUT=5

# "port is already allocated": uncomment and pick a free port (DB_PORT also changes DATABASE_URL above).
#API_PORT=3001
#DB_PORT=5433
